rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      // Sirf aapke Owner Firebase UID ko product add/edit/delete ki permission hai.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "PASTE_OWNER_UID";
    }
  }
}
