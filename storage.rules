rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product photos can be viewed by all website visitors.
    match /products/{ownerUid}/{productId}/{fileName} {
      allow read: if true;
      // Only the one configured Owner account may upload, replace, or delete photos.
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && ownerUid == "PASTE_OWNER_UID"
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')));
    }
  }
}
